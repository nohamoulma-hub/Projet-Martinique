# Modèle de fichier .env : copier en .env (non versionné) et adapter si besoin.
APP_NAME=Martinique API
ENVIRONMENT=development
# Origines autorisées à appeler l'API (frontend local), séparées par des virgules.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Clé secrète pour signer les tokens JWT : générer une valeur aléatoire robuste en production.
JWT_SECRET_KEY=changeme
JWT_EXPIRE_HOURS=24
