# Variables utilisées par docker-compose.yml.
# Copier ce fichier en .env (non versionné) et remplacer les valeurs.
#
#   cp .env.example .env
#
# Ne pas confondre avec backend/.env, qui sert uniquement quand on lance le backend
# à la main sans Docker. Dans les conteneurs, les variables ci-dessous ont la priorité.

# Mot de passe PostgreSQL. Utilisé par le service db et par l'URL de connexion du backend.
POSTGRES_PASSWORD=changeme

# Clé de signature des tokens JWT. Obligatoire : docker compose refuse de démarrer sans.
# Générer une valeur robuste avec : openssl rand -hex 32
JWT_SECRET_KEY=changeme

# Durée de validité d'un token, en heures.
JWT_EXPIRE_HOURS=24
